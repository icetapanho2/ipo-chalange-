# Fornecedor da extracção: gemini | anthropic | local | cache
# Por omissão: gemini se GEMINI_API_KEY existir; caso contrário, cache.
EXTRACTOR=cache

# Se o texto escrito coincidir com um dos textos da demo, usa sempre a cache (garante a
# demo mesmo com um fornecedor ao vivo ligado); qualquer outro texto vai ao fornecedor.
DEMO_CACHE_PRIMEIRO=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cloud Run define PORT automaticamente; em local, por omissão 3001.
PORT=3001
